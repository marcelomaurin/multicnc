program test_extended_models;
{$mode objfpc}{$H+}
uses Math,multiphysics_circuit_models,multiphysics_motion_models;
var R:TResistorModel;C:TCapacitorModel;L:TInductorModel;D:TDiodeModel;M:TMOSFETModel;Rel:TRelayModel;St:TStepperModel;Sv:TServoModel;B:TBLDCModel;G:TGearModel;S:TLeadScrewModel;SD:TSpringDamperModel;I:Double;
begin R.Resistance:=100;if Abs(ResistorCurrent(R,10)-0.1)>1e-9 then Halt(1);C.Capacitance:=0.001;C.Voltage:=0;CapacitorStep(C,1,0.001);if C.Voltage<=0 then Halt(2);L.Inductance:=0.1;L.Current:=0;InductorStep(L,10,0.01);if L.Current<=0 then Halt(3);D.ForwardVoltage:=0.7;D.OnResistance:=1;if DiodeCurrent(D,1)<=0 then Halt(4);M.RdsOn:=0.1;M.Threshold:=3;if MOSFETCurrent(M,12,5)<=0 then Halt(5);Rel.PullInVoltage:=9;RelayStep(Rel,12);if not Rel.Closed then Halt(6);St.StepsPerRev:=200;St.Microsteps:=16;St.Angle:=0;StepperPulse(St,1);if St.Angle<=0 then Halt(7);Sv.Target:=1;Sv.MaxSpeed:=2;Sv.Kp:=5;ServoStep(Sv,0.1);if Sv.Position<=0 then Halt(8);B.Kt:=0.1;B.Ke:=0.1;B.Resistance:=1;B.Inertia:=0.01;I:=BLDCStep(B,12,0,0.01);if(I<=0)or(B.Velocity<=0)then Halt(9);G.Ratio:=2;G.Efficiency:=0.9;if Abs(GearOutputTorque(G,1)-1.8)>1e-9 then Halt(10);S.PitchMM:=5;if Abs(ScrewLinearPosition(S,2*Pi)-5)>1e-6 then Halt(11);SD.K:=100;SD.C:=2;SD.RestPosition:=0;if SpringDamperForce(SD,0.1,0)>=0 then Halt(12);Writeln('PASS extended component models');end.
