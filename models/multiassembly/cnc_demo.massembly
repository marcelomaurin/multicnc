      "title" : "Instalação do Botão E-Stop",
      "instructions" : "Instalar o botao E-Stop no painel frontal.",
      "tools" : "Chave de fenda 3mm",
      "checks" : "Testar acionamento mecanico.",
      "components" : [
        "ESTOP"
      ]
    },
