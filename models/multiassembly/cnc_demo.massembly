      "id" : "STEP_4",
      "order" : 4,
      "title" : "Instalação do Painel Elétrico",
      "instructions" : "Fixar controladora CTRL, fonte PSU e drivers DRVX, DRVY, DRVZ.",
      "tools" : "Chave Philips PH1",
      "checks" : "Garantir refrigeracao e ventilacao.",
      "components" : [
        "CTRL",
        "PSU",
