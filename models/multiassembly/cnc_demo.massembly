        "MZ"
      ]
    },
    {
      "id" : "STEP_3",
      "order" : 3,
      "title" : "Montagem do Spindle",
      "instructions" : "Encaixar o Spindle SP no carro Z e apertar os parafusos de fixacao.",
      "tools" : "Chave Allen 4mm",
      "checks" : "Verificar perpendicularidade com a mesa.",
      "components" : [
        "SP"
      ]
    },
