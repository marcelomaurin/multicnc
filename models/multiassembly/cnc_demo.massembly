      "id" : "STEP_2",
      "order" : 2,
      "title" : "Instalação dos Motores de Passo",
      "instructions" : "Fixar os motores MX, MY e MZ nos suportes da estrutura.",
      "tools" : "Chave Allen 2.5mm",
      "checks" : "Conferir alinhamento dos eixos.",
      "components" : [
